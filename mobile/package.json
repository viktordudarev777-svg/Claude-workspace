{
  "name": "foodlens-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "FoodLens \u2014 scan a food label, get a plain-language verdict",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:snapshot": "tsx scripts/build-snapshot.ts"
  },
  "dependencies": {
    "@foodlens/engine": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.18",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-localization": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@foodlens/data": "*",
    "@types/node": "^22.10.5",
    "@types/react": "~19.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "@react-native-ml-kit/text-recognition": "^2.0.0"
  }
