# --- FoodLens backend configuration -------------------------------------
PORT=4000
NODE_ENV=development

# SQLite database file. ":memory:" is allowed for tests.
DATABASE_PATH=./data/foodlens.db

# OpenFoodFacts. The staging host (world.openfoodfacts.net) requires basic auth
# (off:off) and is meant for write tests; read traffic should use the prod host.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=FoodLens/1.0 (contact@example.com)
OFF_TIMEOUT_MS=6000
# Set to 0 to run fully offline (barcode lookups then return "not found").
OFF_ENABLED=1

# Product recognition from a photo. One of: none | google-vision | clarifai
VISION_PROVIDER=none
GOOGLE_VISION_API_KEY=
CLARIFAI_PAT=
CLARIFAI_MODEL=food-item-recognition

# Server-side OCR fallback used when the phone has no on-device OCR.
# One of: none | google-vision
OCR_PROVIDER=none

# Comma separated origins, or * for any.
CORS_ORIGIN=*
